<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 by default. The CI matrix passes -p:DotnetTfm=net9.0 to test on .NET 9. A custom property is needed:
      MSBuild drops the TargetFramework global property for referenced projects, but passes this one on.
    -->
    <DotnetTfm Condition="'$(DotnetTfm)' == ''">net10.0</DotnetTfm>
    <TargetFramework>$(DotnetTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
